# An image that starts *successfully* and then dies. Unlike Dockerfile.broken, `POST /start`
# returns 204 here — the daemon is perfectly happy — so only probing the container after the
# start can tell that the update failed (plan task 10, liveness gate):
#   stop old -> rename old -> create new (ok) -> start new (ok) -> probe: exited ->
#   remove new -> rename old back -> start old  => original is running again, old image intact.
#
# It dies three seconds in, and the timing is the point of the scenario. This image declares no
# healthcheck, so the gate has no positive evidence to end on and watches the whole
# KODKOD_UPDATE_VERIFY_SECONDS window (8s in compose.rollback.yml). Three seconds is comfortably
# past the ~1s three-probe mark an earlier gate exited on — the shape this scenario exists to
# catch is exactly the container that survives the first probes and then exits — and comfortably
# inside the window, so the gate must still be watching when it happens.
FROM busybox:1.36
ENV APP_VARIANT=crasher
LABEL app.variant=crasher
CMD ["sh", "-c", "echo '[testapp] starting, then dying on purpose'; sleep 3; exit 1"]
